{
  "name": "nexo-angular",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "scripts": {
    "start": "ng serve --host 127.0.0.1 --port 4200",
    "build": "ng build",
    "postbuild": "node scripts/legacy-pages.cjs",
    "build:pages": "ng build --base-href /Nexo/",
    "postbuild:pages": "node scripts/legacy-pages.cjs",
    "test:e2e": "playwright test",
    "format": "prettier --write src e2e scripts *.json *.ts *.md",
    "format:check": "prettier --check src e2e scripts *.json *.ts *.md"
  },
  "dependencies": {
    "@angular/common": "22.2.2",
    "@angular/compiler": "22.2.2",
    "@angular/core": "22.2.2",
    "@angular/forms": "22.2.2",
    "@angular/platform-browser": "22.2.2",
    "@angular/router": "22.2.2",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.2",
    "@angular/cli": "22.2.2",
    "@angular/compiler-cli": "22.2.2",
    "@playwright/test": "^1.56.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2"
  }
}
